# API 基地址。留空时排行榜/登录走 Vite 同源代理（→ localhost:8000，即 Crawl）。
# 若直接连后端（可能跨域）可写：VITE_API_BASE=http://localhost:8000
# VITE_API_BASE=

# OpenMAIC API 基地址（可为 http://localhost:3000 或同源代理 /openmaic）
# VITE_OPENMAIC_BASE_URL=http://localhost:3000
# VITE_OPENMAIC_BASE_URL=/openmaic
#
# 仅当 BASE_URL 用 /openmaic 代理时：整页跳转课堂仍指向 Next 本机端口（可改生产地址）
# VITE_OPENMAIC_APP_URL=http://localhost:3000

# 是否强制使用 Mock：true=始终 Mock，false=使用真实接口（需配置 VITE_API_BASE）
# VITE_USE_MOCK=true
# 视频榜 Mock（默认 true）；false 才请求 /api/ranks/.../video
# VITE_RANK_VIDEO_MOCK=true
# 微博/话题榜 Mock（默认 false=真实接口）；无后端时可设 true
# VITE_RANK_WEIBO_MOCK=false
